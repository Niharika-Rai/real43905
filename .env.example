# Optional: free signup at https://api.census.gov/data/key_signup.html
# Not required for small pulls, but recommended to avoid rate limiting.
CENSUS_API_KEY=

# Optional: free signup at https://fred.stlouisfed.org/docs/api/api_key.html
# The fredgraph.csv endpoint used by pipeline/fetch_fred.py works without
# a key; set this only if you switch to the JSON API.
FRED_API_KEY=

# Set to 1 to attempt live data pulls when building the dataset; defaults
# to 0 (synthetic-only) if unset.
ENABLE_LIVE_FETCH=0
